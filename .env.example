# Copy to .env and fill in the values. .env is git-ignored.

# --- Database (used by the "db" service and by the API connection string) ---
# Keep the password free of ; ' " $ and spaces: it is embedded in a connection string.
POSTGRES_USER=maiaflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=maiaflow

# --- Full stack (docker compose up -d) ---
# JWT signing key, at least 32 characters. Generate one with:  openssl rand -base64 48
# The API refuses to start while this is empty or still starts with CHANGE_ME.
JWT_KEY=CHANGE_ME

# Public URL of the web app exactly as typed in the browser (scheme + host + port, no path).
# Needed when the app is reached under another address than http://localhost:<WEB_PORT>,
# e.g. behind a reverse proxy. Leave empty for local use. It is also baked into the web image at
# build time, so rebuild after changing it:  docker compose up -d --build
APP_ORIGIN=

# "true" only when a reverse proxy in front of the web app sets (overwrites) the
# X-Forwarded-For header. The sign-in and sign-up actions then pass the visitor's IP to the API, so
# its rate limits apply per visitor. Otherwise leave it "false" (a visitor could forge the header);
# all visitors then share the web container's rate-limit bucket.
FORWARD_CLIENT_IP=false

# Host port and interface of the web app. 127.0.0.1 keeps it private; use 0.0.0.0 to expose it.
WEB_PORT=3000
WEB_BIND=127.0.0.1

# Comma-separated CIDR ranges of the reverse proxies whose X-Forwarded-* headers the API trusts.
# The default covers Docker bridge networks.
TRUSTED_PROXY_NETWORKS=172.16.0.0/12

# Optional, only with docker-compose.expose-api.yml: publish the API on the host.
# API_PORT=5012
# API_BIND=127.0.0.1
